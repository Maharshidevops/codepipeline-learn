{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)", "Read(./**/*.pem)"],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm run format:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/statusline.mjs"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/block-dangerous-bash.mjs" }]
      },
      {
        "matcher": "Glob|Grep",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/graph-hint.mjs" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/lint-check.mjs" }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/graphify-update.mjs" },
          { "type": "command", "command": "node .claude/hooks/desktop-notify.mjs" }
        ]
      }
    ]
  }
}
