{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [{ "command": "node ./.cursor/hooks/block-dangerous-bash.mjs" }],
    "beforeReadFile": [{ "command": "node ./.cursor/hooks/block-secret-reads.mjs" }],
    "afterFileEdit": [{ "command": "node ./.cursor/hooks/lint-check.mjs" }],
    "stop": [
      { "command": "node ./.cursor/hooks/graphify-update.mjs" },
      { "command": "node ./.cursor/hooks/desktop-notify.mjs" }
    ]
  }
}
