# =============================================================================
# Quralyst frontend — local development template (copy to `.env`)
#
# Vite bakes VITE_* into the static bundle at build time. Never put server-only
# secrets here (API keys, DB strings, OAuth client secrets, etc.).
#
# Local dev: copy this file to `.env` and fill in values.
# Production: either copy manually on the build host OR enable AWS Secrets Manager
# (see scripts/load-aws-secrets.mjs) so VITE_* keys are pulled from the secret
# JSON before `npm run build`.
# =============================================================================

# ---- API (empty = same-origin; Vite dev proxy routes /api → backend) ----
VITE_API_BASE_URL=

# ---- Ops diagnostic page only (/backend-connection-testing) ----
# Optional override when testing a different backend than the rest of the app.
VITE_BACKEND_CONNECTION_TEST_URL=

# ---- Sentry (frontend) — blank = reporting off ----
VITE_ERROR_REPORTING_DSN=

# ---- Frontend log shipping to POST /api/logs ----
VITE_LOG_SHIPPING=false

# Mirror dev logs — warnings, errors, error popups, and EVERY API request/response — to the terminal
# running `npm run dev` (Phase 40), so you can watch frontend activity where you develop, not only in
# the browser devtools. Default ON in dev; automatically OFF in tests and production builds. Set
# 'false' to silence the terminal bridge.
VITE_LOG_TO_TERMINAL=true

# ---- Release tag for Sentry (optional; set in CI/build) ----
# VITE_APP_VERSION=

# ---- AWS Secrets Manager verification probes (non-secret test values) ----
# Put the same keys in the Secrets Manager JSON when using AWS_SECRETS_ENABLED.
# Change values in AWS, rebuild the frontend, and re-open /backend-connection-testing.
VITE_SECRETS_HEALTH_PROBE_A=local-a
VITE_SECRETS_HEALTH_PROBE_B=local-b

# ---- AWS Secrets Manager bootstrap (build host only — NOT baked into bundle) ----
# EC2/CodeDeploy: export these before `npm run build` / docker build.
# AWS_SECRETS_ENABLED=true
# AWS_SECRET_NAME=quralyst/dev/backend/env
# AWS_REGION=us-west-1
