{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UseGitHubConnection",
      "Effect": "Allow",
      "Action": "codestar-connections:UseConnection",
      "Resource": "CONNECTION_ARN"
    },
    {
      "Sid": "RunCodeBuild",
      "Effect": "Allow",
      "Action": [
        "codebuild:StartBuild",
        "codebuild:BatchGetBuilds"
      ],
      "Resource": "arn:aws:codebuild:REGION:ACCOUNT_ID:project/quralyst-frontend-personal"
    },
    {
      "Sid": "PipelineArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::PIPELINE_ARTIFACT_BUCKET",
        "arn:aws:s3:::PIPELINE_ARTIFACT_BUCKET/*"
      ]
    },
    {
      "Sid": "DeployWebsite",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::WEBSITE_BUCKET",
        "arn:aws:s3:::WEBSITE_BUCKET/*"
      ]
    }
  ]
}
